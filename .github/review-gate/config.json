{
  "_comment": "Review gate settings for qvictl/koreader-base (logic: review_gate.py, policy: REVIEW_POLICY.md).",
  "merge_method": "MERGE",
  "merge_method_overrides": [
    {
      "head_ref": "sync/upstream-*",
      "method": "MERGE"
    }
  ],
  "max_changed_lines": 500,
  "test_paths": [
    "spec/**",
    "**/spec/**",
    "**/*_spec.lua",
    "test-runner/**"
  ],
  "doc_paths": [
    "**/*.md",
    "doc/**",
    "docs/**"
  ],
  "sensitive_paths": [
    ".github/**",
    ".ci/**",
    ".circleci/**",
    "REVIEW_POLICY.md",
    "CONTRIBUTING.md",
    ".coderabbit.yaml",
    ".coderabbit.yml",
    ".gemini/**",
    ".luacheckrc",
    ".luacov",
    ".gitmodules",
    ".cmakelintrc",
    "thirdparty/**",
    "toolchain/**",
    "cmake/**",
    "CMakeLists.txt",
    "**/CMakeLists.txt",
    "**/*.cmake",
    "Makefile",
    "Makefile.defs",
    "make/**",
    "cache-key.base",
    "origin.ldflags",
    "kotasync/**",
    "utils/**",
    "test-runner/**",
    "ffi/crypto.lua",
    "ffi/sha2.lua",
    "ffi/MD5.lua"
  ],
  "sensitive_line_patterns": [
    {
      "path": "ffi/**/*.lua",
      "regex": "(?i)(password|passwd|userkey|secret|credential|oauth|api_?key|access_token|refresh_token|auth_token|private_key)",
      "description": "凭据相关代码"
    }
  ],
  "sync_head_prefix": "sync/upstream-"
}
